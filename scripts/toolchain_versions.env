# The one place every build tool version is pinned (Pico spec KE1, KD6).
# Sourced by scripts/setup_toolchain.sh and scripts/build_firmware.sh on the
# development machine and in continuous integration alike. Evidence for each
# figure is in docs/evaluation/ACTUAL_CONTRACT_EVALUATION.md 4.1.

PICO_SDK_TAG=2.3.1
PICO_SDK_COMMIT=079c6f39023649b154152db30f1d781e884879bc

# Arm GNU Toolchain, downloaded from Arm's own release location. pico-sdk
# 2.3.1 documents no particular GCC version; this is the release current on
# 2026-09-15, and the digests are Arm's published .sha256asc values.
ARM_TOOLCHAIN_VERSION=15.2.rel1
ARM_TOOLCHAIN_BASE_URL=https://developer.arm.com/-/media/Files/downloads/gnu/15.2.rel1/binrel
ARM_TOOLCHAIN_LINUX_X86_64_ARCHIVE=arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi.tar.xz
ARM_TOOLCHAIN_LINUX_X86_64_SHA256=597893282ac8c6ab1a4073977f2362990184599643b4c5ee34870a8215783a16
ARM_TOOLCHAIN_WINDOWS_X86_64_ARCHIVE=arm-gnu-toolchain-15.2.rel1-mingw-w64-x86_64-arm-none-eabi.zip
ARM_TOOLCHAIN_WINDOWS_X86_64_SHA256=7936cac895611023ffb22a64b8e426098c7104cb689778c1894572ca840b9ece
